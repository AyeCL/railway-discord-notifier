PORT=3000
WEBHOOK_PATH=/webhooks/railway
WEBHOOK_SECRET=replace-me
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/webhook

# Use one of the Railway auth options below:
# 1. Single account/workspace token that can read both staging and production:
# RAILWAY_API_TOKEN=
#
# 2. Single project token when you only need one environment:
# RAILWAY_PROJECT_TOKEN=
#
# 3. Per-environment project tokens. Keys can be env names or env IDs:
# RAILWAY_PROJECT_TOKEN_MAP_JSON={"staging":"token-for-staging","production":"token-for-production"}

ENVIRONMENT_ALLOWLIST=staging,production
STATUS_ALLOWLIST=SUCCESS,FAILED,CRASHED
SERVICE_DENYLIST=Redis
FAILURE_MENTION=@here

LOG_TAIL_LINE_LIMIT=40
LOG_TAIL_CHAR_LIMIT=2800
RAILWAY_LOG_FETCH_LIMIT=120
LOG_FETCH_MAX_ATTEMPTS=3
LOG_FETCH_RETRY_MS=1500
EVENT_CACHE_TTL_MS=86400000
REQUEST_TIMEOUT_MS=5000
